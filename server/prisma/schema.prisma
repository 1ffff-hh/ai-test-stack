// 数据模型。SQLite 用于本地开发和单机部署；
// 换 PostgreSQL 时只改 provider 和 DATABASE_URL，业务代码不用动。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 用户。role 用字符串而不是 enum——SQLite 不支持 Prisma enum，
/// 取值在 zod 层校验（USER / ADMIN），换 Postgres 后可以再改成原生 enum。
model User {
  id        Int        @id @default(autoincrement())
  /// 登录账号。必填、唯一；邮箱只是找回密码用的辅助信息，可以留空。
  username  String     @unique
  email     String?    @unique
  name      String
  password  String
  role      String     @default("USER")
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  sessions  Session[]
  favorites Favorite[]
  logs      AuditLog[]

  @@index([createdAt])
}

/// 登录会话。token 存 SHA-256 摘要，库被读走也不能直接拿去冒充用户。
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// 收藏。登录后跨设备同步；未登录时只存在浏览器 localStorage。
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  refId     String
  name      String?
  createdAt DateTime @default(now())

  @@unique([userId, kind, refId])
  @@index([userId])
}

/// 内容条目。data 存原始 JSON，保持和 data/*.json 一一对应，
/// 这样发布时可以直接导出，静态构建脚本不需要知道数据库的存在。
model Document {
  id         Int      @id @default(autoincrement())
  collection String
  key        String
  data       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([collection, key])
  @@index([collection])
}

/// 操作日志。后台改了什么、谁改的、什么时候，都要能查。
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
