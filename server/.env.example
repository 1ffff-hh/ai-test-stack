# 复制成 server/.env 后按需修改。.env 不进仓库。
DATABASE_URL="file:../.data/app.db"

PORT=4174
NODE_ENV=development

# 首次启动时创建的管理员账号（只在库里还没有管理员时生效）
ADMIN_EMAIL="admin@localhost"
# 留空则随机生成并打印一次
ADMIN_PASS=""

# 会话有效期（天）
SESSION_DAYS=14

# 生产环境：前端站点和后台的对外地址，用于 CORS 和 Cookie Secure
# SITE_ORIGIN="https://example.com"
