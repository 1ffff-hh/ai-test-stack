{
  "name": "ai-test-stack",
  "version": "1.0.0",
  "private": true,
  "description": "AI 工具选型 × 测试角色 × AI 冲击决策站：静态站 + Express/Prisma API + Vue 管理后台",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "admin"
  ],
  "scripts": {
    "build": "node build.js",
    "site": "node scripts/build-site.js",
    "seo": "node scripts/build-seo-pages.js",
    "community": "node scripts/refresh-community.js",
    "domain": "node scripts/set-domain.js",
    "serve": "node scripts/serve.js",
    "preview": "node build.js && node scripts/build-site.js && node scripts/serve.js",
    "pii": "node scripts/check-pii.js",
    "pii:self-test": "node scripts/check-pii.js --self-test",
    "audit": "node scripts/a11y-audit.js",
    "verify": "node scripts/verify.js",
    "feed": "node scripts/build-feed.js",
    "og": "node scripts/build-og.js",
    "check": "node build.js && node scripts/check-pii.js --self-test && node scripts/check-pii.js && node scripts/a11y-audit.js && node scripts/verify.js && node scripts/build-site.js",
    "refresh": "node scripts/refresh.js",
    "refresh:dry": "node scripts/refresh.js --dry",
    "refresh:offline": "node scripts/refresh.js --offline",
    "data": "node scripts/data-doctor.js",
    "data:triage": "node scripts/data-triage.js",
    "data:parse": "node scripts/parse-pricing.js",
    "data:parse:fixtures": "node scripts/parse-pricing.js --fixtures",
    "data:parse:test": "node scripts/parse-pricing.js --offline",
    "data:set": "node scripts/set-price.js",
    "shots": "node scripts/shots.js",

    "server": "npm --workspace @ats/server run dev",
    "admin": "npm --workspace @ats/admin run dev",
    "dev": "concurrently -n api,admin -c cyan,magenta \"npm:server\" \"npm:admin\"",
    "build:admin": "npm --workspace @ats/admin run build",
    "build:server": "npm --workspace @ats/server run build",
    "db:push": "npm --workspace @ats/server run db:push",
    "db:seed": "npm --workspace @ats/server run seed",
    "publish": "npm --workspace @ats/server run publish",
    "admin:reset": "npm --workspace @ats/server run admin:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.64.0"
  }
}
